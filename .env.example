# PhishCatch SOC local configuration.
# Copy this file to .env at the repository root. Never commit .env or real keys.

# Maximum accepted .eml size in bytes (default 1 MiB).
PHISHCATCH_MAX_UPLOAD_BYTES=1048576

# SQLite file created relative to the process working directory (run from backend/).
PHISHCATCH_DATABASE_URL=sqlite:///./data/phishcatch.db

# Comma-separated browser origins for the local frontend.
PHISHCATCH_CORS_ORIGINS=http://127.0.0.1:8742,http://localhost:8742

# Reputation lookups are stubbed and off by default. No request is sent when false.
# A skipped lookup is not evidence that an indicator is safe.
PHISHCATCH_REPUTATION_ENABLED=false
PHISHCATCH_REPUTATION_TIMEOUT_SECONDS=3
PHISHCATCH_VT_API_KEY=
PHISHCATCH_URLHAUS_AUTH_KEY=

# The AI explainer is stubbed and off by default. It never assigns the risk label.
# When enabled without a live model, output is still schema-validated or discarded.
PHISHCATCH_AI_ENABLED=false
PHISHCATCH_AI_TIMEOUT_SECONDS=5
PHISHCATCH_AI_API_KEY=
PHISHCATCH_AI_MODEL=

# Google Gemini (AI Studio free tier) is the first live explainer.
# The key is read only from GEMINI_API_KEY, on the backend. It is never sent
# to the browser, never logged, and must never be committed. Leave it empty.
# Enable the live path with AI_EXPLAINER_PROVIDER=gemini and a key.
# GEMINI_MODEL defaults to gemini-2.5-flash when empty.
# The free tier may use submitted prompts to improve Google products.
# In the demo, send only synthetic samples and public-corpus mail.
GEMINI_API_KEY=
GEMINI_MODEL=
AI_EXPLAINER_PROVIDER=

# Authentication-Results is scored only when its authserv-id is in this list.
# Uploaded mail can forge the header. Empty means those results are not scored.
PHISHCATCH_TRUSTED_AUTHSERV_IDS=
# Opt-in RDAP lookup for the From domain. Off by default. Never fetches mail URLs.
PHISHCATCH_RDAP_ENABLED=false

PHISHCATCH_LOG_LEVEL=INFO
